{
  "name": "curriculum-as-code",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "audit": "npm run lint:md",
    "lint:md": "markdownlint --config .markdownlint.json \"content/**/*.md\"",
    "lint:md:fix": "markdownlint --config .markdownlint.json --fix \"content/**/*.md\"",
    "predeploy": "npm run audit"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.41.0"
  }
}
