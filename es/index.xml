lor: #FFFFFF;&#10; color: #0B192C;&#10; border: 1.5px solid #D4D4D8;&#10; border-radius: 0.625rem;&#10; padding: 0.85rem;&#10; }&#10; .gail-trap {&#10; margin-top: 0.85rem;&#10; padding: 0.75rem 0.9rem;&#10; border-radius: 0.5rem;&#10; background-color: #FFFFFF;&#10; color: #940925;&#10; border: 1.5px solid #940925;&#10; font-size: 0.8rem;&#10; line-height: 1.45;&#10; }&#10; .gail-sim-layout {&#10; display: grid;&#10; grid-template-columns: repeat(1, minmax(0, 1fr));&#10; gap: 1rem;&#10; }&#10; @media (min-width: 768px) {&#10; .gail-sim-layout {&#10; grid-template-columns: 1fr 1.35fr;&#10; }&#10; }&#10; .gail-sim-choice {&#10; display: block;&#10; width: 100%;&#10; min-height: 44px;&#10; text-align: left;&#10; padding: 0.65rem 0.85rem;&#10; margin-bottom: 0.5rem;&#10; border-radius: 0.5rem;&#10; border: 1.5px solid #0B192C;&#10; background-color: #FFFFFF;&#10; color: #0B192C;&#10; font-size: 0.8rem;&#10; font-weight: 700;&#10; cursor: pointer;&#10; }&#10; .gail-sim-choice[aria-pressed="true"] {&#10; background-color: #0B192C;&#10; color: #FFFFFF;&#10; }&#10; .gail-prs-box {&#10; background-color: #FAFBF7;&#10; color: #0B192C;&#10; border: 2px solid #0B192C;&#10; border-radius: 0.875rem;&#10; padding: 1.15rem;&#10; }&#10; .gail-prs-step {&#10; background-color: #FFFFFF;&#10; color: #0B192C;&#10; border: 1.5px solid #0B192C;&#10; border-radius: 0.625rem;&#10; padding: 0.75rem 0.9rem;&#10; margin-bottom: 0.65rem;&#10; }&#10; .gail-quiz-card {&#10; background-color: #FAFBF7;&#10; color: #0B192C;&#10; border: 1.5px solid #0B192C;&#10; border-radius: 0.75rem;&#10; padding: 1rem;&#10; margin-bottom: 0.9rem;&#10; }&#10; .gail-opt-choice {&#10; display: block;&#10; width: 100%;&#10; min-height: 44px;&#10; text-align: left;&#10; padding: 0.6rem 0.85rem;&#10; margin-top: 0.45rem;&#10; border-radius: 0.5rem;&#10; border: 1.5px solid #0B192C;&#10; background-color: #FFFFFF;&#10; color: #0B192C;&#10; font-size: 0.81rem;&#10; line-height: 1.4;&#10; cursor: pointer;&#10; }&#10; .gail-opt-choice:hover {&#10; background-color: #F2EDE4;&#10; color: #0B192C;&#10; }&#10; .gail-opt-correct {&#10; background-color: #0D5156;&#10; color: #FFFFFF;&#10; border-color: #0D5156;&#10; font-weight: 700;&#10; }&#10; .gail-opt-correct:hover {&#10; background-color: #0D5156;&#10; color: #FFFFFF;&#10; }&#10; .gail-opt-wrong {&#10; background-color: #940925;&#10; color: #FFFFFF;&#10; border-color: #940925;&#10; }&#10; .gail-opt-wrong:hover {&#10; background-color: #940925;&#10; color: #FFFFFF;&#10; }&#10; .gail-rationale {&#10; margin-top: 0.65rem;&#10; padding: 0.7rem 0.85rem;&#10; border-radius: 0.5rem;&#10; border: 1.5px solid #0B192C;&#10; background-color: #FFFFFF;&#10; color: #0B192C;&#10; font-size: 0.8rem;&#10; line-height: 1.45;&#10; }&#10; .gail-check-row {&#10; display: flex;&#10; align-items: flex-start;&#10; gap: 0.7rem;&#10; min-height: 44px;&#10; padding: 0.55rem 0.75rem;&#10; border: 1px solid #D4D4D8;&#10; border-radius: 0.5rem;&#10; background-color: #FFFFFF;&#10; color: #0B192C;&#10; margin-bottom: 0.5rem;&#10; cursor: pointer;&#10; font-size: 0.82rem;&#10; line-height: 1.45;&#10; }&#10; .gail-checkbox {&#10; width: 24px;&#10; height: 24px;&#10; min-width: 24px;&#10; min-height: 24px;&#10; margin-top: 0.1rem;&#10; accent-color: #0B192C;&#10; cursor: pointer;&#10; }&#10; @media print {&#10; .gail-tablist, .gail-toolbar { display: none; }&#10; .gail-tabpanel[hidden] { display: block !important; }&#10; }&#10; &lt;/style&gt;&#10;&#10; &#10; &lt;div class="gail-banner"&gt;&#10; &lt;span class="gail-eyebrow"&gt;ON-DEMAND STUDENT TOOL &amp;bull; #GAIL2026 &amp;bull; v1.1.3 (Updated 2026-11-13)&lt;/span&gt;&#10; &lt;h2 class="text-xl sm:text-2xl font-extrabold m-0 mb-2" style="color:#FFFFFF;background-color:#0B192C;"&gt;Google Cloud Generative AI Leader (GAIL) — 2026 On-Demand Student Study &amp; Practice Hub&lt;/h2&gt;&#10; &lt;p class="text-xs sm:text-sm m-0" style="color:#FAFBF7;background-color:#0B192C;line-height:1.55;"&gt;&#10; Open-access, zero-login exam preparation workbench reconciling Google Cloud&amp;#39;s 2025 Vertex AI / Agentspace terminology with the 2026 Gemini Enterprise Agent Platform curriculum.&#10; &lt;/p&gt;</description></item><item><title>Ensayo 40: ¿Qué Pasaría Si No Operacionalizara el Marco? – Transformando el Aviso U.S. DOL ETA TEN No. 07-25 en Curriculum-as-Code Accesible de Origen</title><link>https://alanpruitt.com/es/essays/essay-40-federal-workforce-ai-literacy/</link><pubDate>Mon, 09 Nov 2026 21:30:00 -0700</pubDate><guid>https://alanpruitt.com/es/essays/essay-40-federal-workforce-ai-literacy/</guid><description>Operacionalización del Aviso U.S. DOL ETA TEN No. 07-25 en recursos educativos abiertos ($0 ZTC OER) mediante Curriculum-as-Code (S-A-R v2.2), IA local aislada y accesibilidad verificada.</description></item><item><title>Ensayo 39: ¿Qué Pasaría Si No Automatizara el Umbral? – Validación Programática de Rúbricas en Canvas y Flujos de IA en el Borde</title><link>https://alanpruitt.com/es/essays/essay-39-automate-the-threshold/</link><pubDate>Wed, 04 Nov 2026 12:40:00 -0700</pubDate><guid>https://alanpruitt.com/es/essays/essay-39-automate-the-threshold/</guid><description>Cómo automatizar la validación de rúbricas 10-7-0 con piso cero en Canvas GraphQL y auditorías locales de IA en el borde garantiza rigor clínico, accesibilidad 9:1 y privacidad FERPA.</description></item><item><title>Ensayo 29: El Cambio Aguas Arriba — Por Qué la Accesibilidad Post-Producción Es un Fallo de Diseño Arquitectónico</title><link>https://alanpruitt.com/es/essays/essay-29/</link><pubDate>Sat, 29 Aug 2026 09:30:00 -0700</pubDate><guid>https://alanpruitt.com/es/essays/essay-29/</guid><description>&lt;h2 id="la-trampa-aguas-abajo-de-la-ti-en-la-educación-superior"&gt;La Trampa Aguas Abajo de la TI en la Educación Superior&lt;/h2&gt;&#10;&lt;p&gt;Durante décadas, el modelo operativo de la educación superior para la accesibilidad digital ha imitado una línea de ensamblaje defectuosa: cree el curso como desee, láncelo al Sistema de Gestión de Aprendizaje (LMS) al inicio del semestre, espere una solicitud de adaptación o una auditoría de cumplimiento, y luego apresúrese a corregir los defectos aguas abajo.&lt;/p&gt;&#10;&lt;p&gt;A medida que las instituciones públicas enfrentan el riguroso cronograma de aplicación de la &lt;strong&gt;Regla Final del Título II de la ADA de la Fiscalía Federal (28 CFR Parte 35)&lt;/strong&gt;, esta mentalidad aguas abajo se ha convertido en una responsabilidad institucional.&lt;/p&gt;</description></item><item><title>Ensayo 28: Más Allá del Cumplimiento Performativo — Título II de la ADA, Declaraciones Vivas de Conformidad y Gobernanza Institucional Automatizada</title><link>https://alanpruitt.com/es/essays/essay-28/</link><pubDate>Fri, 28 Aug 2026 08:00:00 -0700</pubDate><guid>https://alanpruitt.com/es/essays/essay-28/</guid><description>&lt;h2 id="la-ficción-legal-del-descargo-estático"&gt;La Ficción Legal del Descargo Estático&lt;/h2&gt;&#10;&lt;p&gt;Durante dos décadas, la educación superior trató la accesibilidad digital como una nota administrativa a pie de página. Las instituciones copiaban declaraciones genéricas en el pie de página, creaban formularios estándar de solicitud de adaptaciones y asumían que la buena fe las protegía de responsabilidades regulatorias.&lt;/p&gt;&#10;&lt;p&gt;La regla final del &lt;strong&gt;Título II de la ADA (28 CFR Parte 35)&lt;/strong&gt; del Departamento de Justicia puso fin a esa era.&lt;/p&gt;</description></item><item><title>Plan de Estudios como Código, Cumplimiento de ADA Título II y Refactorización de Accesibilidad a Gran Escala</title><link>https://alanpruitt.com/es/essays/essay-27/</link><pubDate>Thu, 27 Aug 2026 08:00:00 -0700</pubDate><guid>https://alanpruitt.com/es/essays/essay-27/</guid><description>&lt;h2 id="el-mandato-federal-el-fin-de-las-soluciones-parche"&gt;El Mandato Federal: El Fin de las Soluciones Parche&lt;/h2&gt;&#10;&lt;p&gt;Para las instituciones de educación superior públicas, el reloj del mandato de accesibilidad de &lt;strong&gt;ADA Título II&lt;/strong&gt; ya está corriendo. La exigencia federal no deja margen de maniobra: para 2026, cada curso, documento digital, tabla y recurso montado en el LMS debe cumplir a rajatabla con el estándar &lt;strong&gt;WCAG 2.2 AA&lt;/strong&gt;.&lt;/p&gt;&#10;&lt;p&gt;Durante más de una década, la respuesta tradicional de las universidades ha sido un ciclo interminable y costoso:&lt;/p&gt;</description></item><item><title>Ensayo 26: Navegando el Cumplimiento Aguas Arriba – El Marco de Auditoría POUR en Currículum como Código</title><link>https://alanpruitt.com/es/essays/26-curriculum-as-code-pour-audit-framework/</link><pubDate>Wed, 19 Aug 2026 00:00:00 +0000</pubDate><guid>https://alanpruitt.com/es/essays/26-curriculum-as-code-pour-audit-framework/</guid><description>Cómo operacionalizo los cuatro principios de accesibilidad POUR (Perceptible, Operable, Comprensible y Robusto) mediante verificaciones automatizadas en Git y CI/CD dentro de Currículum como Código.</description></item><item><title>Calculadora de Retorno de Inversión (ROI)</title><link>https://alanpruitt.com/es/roi-calculator/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://alanpruitt.com/es/roi-calculator/</guid><description>&lt;section id="roi-calculator" class="roi-calc-container" aria-labelledby="roi-calc-title"&gt;&#10; &lt;div class="roi-calc-card"&gt;&#10; &lt;h2 id="roi-calc-title" class="roi-calc-heading"&gt;Interactive Faculty &amp; Institutional Time ROI Calculator&lt;/h2&gt;&#10; &lt;p class="roi-calc-description"&gt;&#10; Calculate the annual institutional time and fiscal dividend recovered by replacing legacy administrative workflows with Sovereign Auditor and GenAI automation frameworks.&#10; &lt;/p&gt;&#10;&#10; &lt;div class="roi-calc-grid"&gt;&#10; &#10; &lt;div class="roi-calc-inputs"&gt;&#10; &lt;div class="roi-input-group"&gt;&#10; &lt;label for="faculty-count" class="roi-label"&gt;&#10; Participating Faculty / Staff&#10; &lt;span id="faculty-count-val" class="roi-val-badge"&gt;25&lt;/span&gt;&#10; &lt;/label&gt;&#10; &lt;input type="range" id="faculty-count" min="1" max="200" value="25" step="1" class="roi-slider" aria-describedby="faculty-count-desc"&gt;&#10; &lt;span id="faculty-count-desc" class="roi-hint"&gt;Total faculty and staff members adopting the workflow.&lt;/span&gt;&#10; &lt;/div&gt;&#10;&#10; &lt;div class="roi-input-group"&gt;&#10; &lt;label for="hours-saved" class="roi-label"&gt;&#10; Hours Saved per Person / Week&#10; &lt;span id="hours-saved-val" class="roi-val-badge"&gt;4.5 hrs&lt;/span&gt;&#10; &lt;/label&gt;&#10; &lt;input type="range" id="hours-saved" min="1" max="15" value="4.5" step="0.5" class="roi-slider" aria-describedby="hours-saved-desc"&gt;&#10; &lt;span id="hours-saved-desc" class="roi-hint"&gt;Admin time saved on syllabus auditing, transcripts, and rubric drafts.&lt;/span&gt;&#10; &lt;/div&gt;&#10;&#10; &lt;div class="roi-input-group"&gt;&#10; &lt;label for="hourly-rate" class="roi-label"&gt;&#10; Blended Hourly Rate ($/hr)&#10; &lt;span id="hourly-rate-val" class="roi-val-badge"&gt;$52&lt;/span&gt;&#10; &lt;/label&gt;&#10; &lt;input type="range" id="hourly-rate" min="25" max="120" value="52" step="1" class="roi-slider" aria-describedby="hourly-rate-desc"&gt;&#10; &lt;span id="hourly-rate-desc" class="roi-hint"&gt;Average institutional compensation (salary + benefits).&lt;/span&gt;&#10; &lt;/div&gt;&#10;&#10; &lt;div class="roi-input-group"&gt;&#10; &lt;label for="weeks-per-year" class="roi-label"&gt;&#10; Academic Weeks per Year&#10; &lt;span id="weeks-per-year-val" class="roi-val-badge"&gt;32 weeks&lt;/span&gt;&#10; &lt;/label&gt;&#10; &lt;input type="range" id="weeks-per-year" min="15" max="52" value="32" step="1" class="roi-slider" aria-describedby="weeks-desc"&gt;&#10; &lt;span id="weeks-desc" class="roi-hint"&gt;Active instruction and administrative service weeks.&lt;/span&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10;&#10; &#10; &lt;div class="roi-calc-results" aria-live="polite" aria-atomic="true"&gt;&#10; &lt;div class="roi-metric-card primary"&gt;&#10; &lt;span class="roi-metric-label"&gt;Annual Institutional Value Recovered&lt;/span&gt;&#10; &lt;span id="roi-annual-savings" class="roi-metric-number"&gt;$187,200&lt;/span&gt;&#10; &lt;span class="roi-metric-subtext"&gt;in instructional &amp; operational capacity&lt;/span&gt;&#10; &lt;/div&gt;&#10;&#10; &lt;div class="roi-metric-subgrid"&gt;&#10; &lt;div class="roi-metric-card"&gt;&#10; &lt;span class="roi-metric-label"&gt;Weekly Hours Reclaimed&lt;/span&gt;&#10; &lt;span id="roi-weekly-hours" class="roi-metric-number"&gt;112.5 hrs&lt;/span&gt;&#10; &lt;span class="roi-metric-subtext"&gt;across institution&lt;/span&gt;&#10; &lt;/div&gt;&#10;&#10; &lt;div class="roi-metric-card"&gt;&#10; &lt;span class="roi-metric-label"&gt;Annual Hours Reclaimed&lt;/span&gt;&#10; &lt;span id="roi-annual-hours" class="roi-metric-number"&gt;3,600 hrs&lt;/span&gt;&#10; &lt;span class="roi-metric-subtext"&gt;redirected to student mentorship&lt;/span&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10;&#10; &lt;div class="roi-callout"&gt;&#10; &lt;strong&gt;Clinical Framing Protocol Impact:&lt;/strong&gt; Automating repetitive compliance checks creates bandwidth for high-impact human connection and student retention.&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/section&gt;&#10;&#10;&lt;style&gt;&#10; .roi-calc-container {&#10; margin: 2rem 0;&#10; font-family: inherit;&#10; scroll-margin-top: 5rem;&#10; }&#10; .roi-calc-card {&#10; background-color: #FFF9F0;&#10; border: 2px solid #002147;&#10; border-radius: 8px;&#10; padding: 1.75rem;&#10; color: #1a1a1a;&#10; }&#10; .roi-calc-heading {&#10; color: #002147;&#10; margin-top: 0;&#10; margin-bottom: 0.5rem;&#10; font-size: 1.35rem;&#10; font-weight: 700;&#10; }&#10; .roi-calc-description {&#10; color: #333333;&#10; font-size: 0.95rem;&#10; margin-bottom: 1.5rem;&#10; line-height: 1.5;&#10; }&#10; .roi-calc-grid {&#10; display: grid;&#10; grid-template-columns: 1fr;&#10; gap: 1.75rem;&#10; }&#10; @media (min-width: 768px) {&#10; .roi-calc-grid {&#10; grid-template-columns: 1.1fr 0.9fr;&#10; }&#10; }&#10; .roi-calc-inputs {&#10; display: flex;&#10; flex-direction: column;&#10; gap: 1.25rem;&#10; }&#10; .roi-input-group {&#10; display: flex;&#10; flex-direction: column;&#10; gap: 0.35rem;&#10; }&#10; .roi-label {&#10; display: flex;&#10; justify-content: space-between;&#10; align-items: center;&#10; font-weight: 600;&#10; font-size: 0.9rem;&#10; color: #002147;&#10; }&#10; .roi-val-badge {&#10; background-color: #002147;&#10; color: #FFF9F0;&#10; padding: 0.15rem 0.55rem;&#10; border-radius: 4px;&#10; font-size: 0.85rem;&#10; font-weight: 700;&#10; }&#10; .roi-slider {&#10; width: 100%;&#10; accent-color: #003366;&#10; cursor: pointer;&#10; margin: 0.25rem 0;&#10; }&#10; .roi-hint {&#10; font-size: 0.78rem;&#10; color: #555555;&#10; }&#10; .roi-calc-results {&#10; display: flex;&#10; flex-direction: column;&#10; gap: 1rem;&#10; justify-content: center;&#10; }&#10; .roi-metric-card {&#10; background-color: #ffffff;&#10; border: 1px solid #d1d5db;&#10; border-radius: 6px;&#10; padding: 1rem;&#10; text-align: center;&#10; display: flex;&#10; flex-direction: column;&#10; gap: 0.25rem;&#10; }&#10; .roi-metric-card.primary {&#10; background-color: #002147;&#10; color: #FFF9F0;&#10; border: none;&#10; padding: 1.25rem 1rem;&#10; }&#10; .roi-metric-card.primary .roi-metric-label {&#10; color: #E2E8F0;&#10; }&#10; .roi-metric-card.primary .roi-metric-subtext {&#10; color: #CBD5E1;&#10; }&#10; .roi-metric-label {&#10; font-size: 0.82rem;&#10; font-weight: 600;&#10; text-transform: uppercase;&#10; letter-spacing: 0.05em;&#10; color: #4b5563;&#10; }&#10; .roi-metric-number {&#10; font-size: 1.75rem;&#10; font-weight: 800;&#10; color: #002147;&#10; }&#10; .roi-metric-card.primary .roi-metric-number {&#10; color: #FACC15;&#10; font-size: 2rem;&#10; }&#10; .roi-metric-subtext {&#10; font-size: 0.8rem;&#10; color: #6b7280;&#10; }&#10; .roi-metric-subgrid {&#10; display: grid;&#10; grid-template-columns: 1fr 1fr;&#10; gap: 0.75rem;&#10; }&#10; .roi-callout {&#10; background-color: #EBF3FA;&#10; border-left: 4px solid #003366;&#10; padding: 0.75rem 0.85rem;&#10; font-size: 0.82rem;&#10; line-height: 1.4;&#10; color: #002147;&#10; border-radius: 0 4px 4px 0;&#10; }&#10;&lt;/style&gt;&#10;&#10;&lt;script&gt;&#10; (function() {&#10; function initRoiCalculator() {&#10; const faculty = document.getElementById('faculty-count');&#10; const hours = document.getElementById('hours-saved');&#10; const rate = document.getElementById('hourly-rate');&#10; const weeks = document.getElementById('weeks-per-year');&#10;&#10; if (!faculty || !hours || !rate || !weeks) return;&#10;&#10; const facultyVal = document.getElementById('faculty-count-val');&#10; const hoursVal = document.getElementById('hours-saved-val');&#10; const rateVal = document.getElementById('hourly-rate-val');&#10; const weeksVal = document.getElementById('weeks-per-year-val');&#10;&#10; const annualSavings = document.getElementById('roi-annual-savings');&#10; const weeklyHours = document.getElementById('roi-weekly-hours');&#10; const annualHours = document.getElementById('roi-annual-hours');&#10;&#10; function calculate() {&#10; const f = parseFloat(faculty.value) || 0;&#10; const h = parseFloat(hours.value) || 0;&#10; const r = parseFloat(rate.value) || 0;&#10; const w = parseFloat(weeks.value) || 0;&#10;&#10; facultyVal.textContent = f;&#10; hoursVal.textContent = h % 1 === 0 ? h + ' hrs' : h.toFixed(1) + ' hrs';&#10; rateVal.textContent = '$' + r;&#10; weeksVal.textContent = w + ' weeks';&#10;&#10; const totalWeeklyHours = f * h;&#10; const totalAnnualHours = totalWeeklyHours * w;&#10; const totalAnnualSavings = totalAnnualHours * r;&#10;&#10; weeklyHours.textContent = totalWeeklyHours.toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' hrs';&#10; annualHours.textContent = totalAnnualHours.toLocaleString('en-US', { maximumFractionDigits: 0 }) + ' hrs';&#10; annualSavings.textContent = '$' + totalAnnualSavings.toLocaleString('en-US', { maximumFractionDigits: 0 });&#10; }&#10;&#10; [faculty, hours, rate, weeks].forEach(el =&gt; {&#10; el.addEventListener('input', calculate);&#10; });&#10;&#10; calculate();&#10; }&#10;&#10; if (document.readyState === 'loading') {&#10; document.addEventListener('DOMContentLoaded', initRoiCalculator);&#10; } else {&#10; initRoiCalculator();&#10; }&#10; })();&#10;&lt;/script&gt;</description></item></channel></rss>